worker_processes  1;

error_log  logs/error.log;

events {
    worker_connections  1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    sendfile        on;
    keepalive_timeout  65;

    charset utf-8;
    client_max_body_size 100M;

    client_body_temp_path temp/client_body_temp;
    proxy_temp_path       temp/proxy_temp;
    fastcgi_temp_path     temp/fastcgi_temp;

    server {
        listen       {{.Port}};
        server_name  localhost;
        root         "{{.WWWRoot}}";
        index        index.php index.html index.htm;

        access_log off;

        location / {
            try_files $uri $uri/ @fallback_ostenia;
        }

        location @fallback_ostenia {
            root "{{.NginxPath}}/html";
            index index.html index.htm;
        }

        {{if gt .PHPPort 0}}
        location ~ \.php$ {
            try_files $uri =404;
            fastcgi_pass   127.0.0.1:{{.PHPPort}};
            fastcgi_index  index.php;
            fastcgi_param  SCRIPT_FILENAME  $document_root$fastcgi_script_name;
            include        fastcgi_params;
        }
        {{else}}
        location ~ \.php$ {
            return 502 "PHP is not running in Ostenia";
        }
        {{end}}

        error_page   500 502 503 504  /50x.html;
        location = /50x.html {
            root   html;
        }
    }

    {{if .HTTPSEnabled}}
    server {
        listen       443 ssl;
        server_name  localhost;
        root         "{{.WWWRoot}}";
        index        index.php index.html index.htm;

        ssl_certificate      "{{.CertFile}}";
        ssl_certificate_key  "{{.KeyFile}}";

        ssl_session_cache    shared:SSL:1m;
        ssl_session_timeout  5m;

        ssl_ciphers  HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers  on;

        location / {
            try_files $uri $uri/ @fallback_ostenia;
        }

        location @fallback_ostenia {
            root "{{.NginxPath}}/html";
            index index.html index.htm;
        }

        {{if gt .PHPPort 0}}
        location ~ \.php$ {
            try_files $uri =404;
            fastcgi_pass   127.0.0.1:{{.PHPPort}};
            fastcgi_index  index.php;
            fastcgi_param  SCRIPT_FILENAME  $document_root$fastcgi_script_name;
            include        fastcgi_params;
        }
        {{end}}

        error_page   500 502 503 504  /50x.html;
        location = /50x.html {
            root   html;
        }
    }
    {{end}}

    {{range .Proxies}}
    server {
        listen       {{$.Port}};
        server_name  {{.Name}}.test *.{{.Name}}.test;

        location / {
            proxy_pass http://127.0.0.1:{{.TargetPort}};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    {{if $.HTTPSEnabled}}
    server {
        listen       443 ssl;
        server_name  {{.Name}}.test *.{{.Name}}.test;

        ssl_certificate      "{{$.SSLDir}}/{{.Name}}.test.crt";
        ssl_certificate_key  "{{$.SSLDir}}/{{.Name}}.test.key";

        location / {
            proxy_pass http://127.0.0.1:{{.TargetPort}};
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
    {{end}}
    {{end}}
}
